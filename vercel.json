{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.bloomsuite.app"
        }
      ],
      "destination": "https://bloomsuite.app/$1",
      "permanent": true
    },
    {
      "source": "/pos/login",
      "destination": "/suite?product=pos",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/pos/features",
      "destination": "/pos-feature-hub.html"
    },
    {
      "source": "/pos/features/",
      "destination": "/pos-feature-hub.html"
    },
    {
      "source": "/pos/features/:slug",
      "destination": "/pos-feature-pages/:slug.html"
    },
    {
      "source": "/pos/features/:slug/",
      "destination": "/pos-feature-pages/:slug.html"
    },
    {
      "source": "/pos/features/:path*",
      "destination": "/api/pos-feature-not-found"
    },
    {
      "source": "/build-your-suite",
      "destination": "/suite-builder.html"
    },
    {
      "source": "/build-your-suite/",
      "destination": "/suite-builder.html"
    },
    {
      "source": "/pos",
      "destination": "/pos-marketing.html"
    },
    {
      "source": "/pos/",
      "destination": "/pos-marketing.html"
    },
    {
      "source": "/suite",
      "destination": "/suite-portal.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
