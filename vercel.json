{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.bloomsuite.app"
        }
      ],
      "destination": "https://bloomsuite.app/$1",
      "permanent": true
    },
    {
      "source": "/pos/login",
      "destination": "https://bloomsuite-pos.vercel.app/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/pos",
      "destination": "/pos-marketing.html"
    },
    {
      "source": "/pos/",
      "destination": "/pos-marketing.html"
    },
    {
      "source": "/suite",
      "destination": "/suite-portal.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
