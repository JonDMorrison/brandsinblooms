{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd .. && pnpm install --frozen-lockfile",
  "buildCommand": "cd .. && pnpm exec vite build --config vite.showroom.config.ts",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [{ "source": "/", "destination": "/crm/", "permanent": false }],
  "rewrites": [{ "source": "/crm/(.*)", "destination": "/crm/index.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "connect-src 'self' data: blob:; frame-ancestors 'none'; form-action 'self'" }
      ]
    }
  ]
}
